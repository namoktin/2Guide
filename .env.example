# Ket noi Co So Du Lieu MongoDB Atlas
# Dan link ket noi MongoDB Atlas cua ban vao day (vi du: mongodb+srv://<username>:<password>@cluster0.mongodb.net/2guide?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/2guide?retryWrites=true&w=majority
