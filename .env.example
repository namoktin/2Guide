# 2Guide - Cau hinh moi truong mau
PORT=4000

# Ma viet tat mac dinh cho Hub: NEU (NEU001, NEU002...)
SITE_CODE=NEU
SITE_NAME=Trường Đại Học Kinh Tế Quốc Dân (NEU)

# Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here
