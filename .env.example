# 2Guide - Cấu Hình Môi Trường Mẫu (Environment Configuration Template)
# Sao chép file này thành .env và điền các khóa bí mật của bạn:
# cp .env.example .env

# Cổng khởi chạy máy chủ web (Mặc định: 4000)
PORT=4000

# Mã di tích và tên di tích mặc định
SITE_CODE=NEU
SITE_NAME=Trường Đại Học Kinh Tế Quốc Dân (NEU)

# Khóa truy cập Groq Cloud AI (Lấy tại https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Chuỗi kết nối cơ sở dữ liệu MongoDB Atlas
# Ví dụ: mongodb+srv://<username>:<password>@cluster0.mongodb.net/2guide?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/2guide?retryWrites=true&w=majority

# ==========================================
# CẤU HÌNH AN NINH & BẢO MẬT (DEFENSE-IN-DEPTH)
# ==========================================

# Đường dẫn bí mật truy cập Cổng Ban Quản Lý (thay thế cho /admin hay /quanly mặc định)
ADMIN_SECRET_PATH=quanly_bql_8869

# Mã bí mật xác thực 2 chiều giữa Thiết Bị ESP32 và Server (X-Device-Secret)
ESP32_SECRET_KEY=esp_sec_2026_98a72b

# Mã bí mật xác thực quyền Quản Trị Viên Ban Quản Lý (ADMIN_SECRET_KEY)
ADMIN_SECRET_KEY=bql_sec_2026_8869
